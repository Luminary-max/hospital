erDiagram
    %% ========================
    %% 设计原则：按业务分层、按职责关联
    %% 挂号订单只管"挂号"本身
    %% 门诊病历是"诊中"核心枢纽
    %% ========================

    %% ===== 基础数据 =====
    科室 {
        int de_id PK
    }
    医生 {
        string d_id PK
        string d_section FK
    }
    患者 {
        int p_id PK
    }
    药品 {
        string dr_id PK
    }
    检查项目 {
        string ch_id PK
    }
    排班 {
        string ar_id PK
        string d_id FK
    }

    %% ===== 第一层：挂号（就诊入口）=====
    %% 挂号订单只关联挂号的参与者
    挂号订单 {
        string o_id PK
        int p_id FK    "谁看病"
        string d_id FK   "挂哪个医生"
    }

    分诊记录 {
        int t_id PK
        int p_id FK
        string d_id FK
    }

    排队叫号 {
        int q_id PK
        int o_id FK
        int p_id FK
        string d_id FK
    }

    %% ===== 第二层：病历（诊中业务核心）=====
    %% 病历是医生写的，是诊疗活动的中心
    门诊病历 {
        int emr_id PK
        int o_id FK     "属于哪次就诊"
        int p_id FK     "患者"
        string d_id FK  "经治医生"
    }

    %% ===== 第三层：医生开立的业务单据 =====
    %% 处方和检查都是医生基于病历开出的
    处方主表 {
        int pm_id PK
        int emr_id FK   "基于哪份病历"
        string d_id FK  "开方医生"
    }
    处方明细 {
        int pd_id PK
        int pm_id FK    "属于哪个处方"
        string dr_id FK "开的什么药"
    }

    检查开单 {
        int oc_id PK
        int emr_id FK   "基于哪份病历"
        string ch_id FK "开的什么检查"
    }

    %% ===== 第四层：执行层 =====
    %% 发药只关联到处方明细，不关心订单和药品
    发药记录 {
        int pds_id PK
        int presc_detail_id FK
        int db_id FK
    }

    %% ===== 第五层：费用层 =====
    %% 收费/退费应基于医疗单据（病历产生的费用项目）
    缴费记录 {
        int br_id PK
        int pm_id FK    "处方产生的药费"
        int oc_id FK    "检查产生的检查费"
        int emr_id FK   "挂号费/诊查费"
    }
    发票 {
        int inv_id PK
        int br_id FK    "基于缴费记录"
    }
    退费申请 {
        int rf_id PK
        int br_id FK    "退哪笔缴费"
    }

    %% =============================================
    %% RELATIONSHIPS — 按业务逻辑分层
    %% =============================================

    %% ── 基础数据关联 ──
    科室 ||--o{ 医生 : "de_id"

    %% ── 第一层：挂号 ──
    患者 ||--o{ 挂号订单 : "p_id → 挂号"
    医生 ||--o{ 挂号订单 : "d_id → 出诊"
    挂号订单 ||--o{ 排队叫号 : "o_id → 排队"
    患者 ||--o{ 分诊记录 : "p_id → 分诊"
    医生 ||--o{ 分诊记录 : "d_id → 接诊"

    %% ── 挂号和病历的关联（病历是一次就诊的医疗记录）──
    挂号订单 ||--o{ 门诊病历 : "o_id → 就诊记录"
    患者 ||--o{ 门诊病历 : "p_id → 就诊"
    医生 ||--o{ 门诊病历 : "d_id → 书写病历"

    %% ── 第二层到第三层：病历 → 医疗单据 ──
    门诊病历 ||--o{ 处方主表 : "emr_id → 开处方"
    门诊病历 ||--o{ 检查开单 : "emr_id → 开检查"

    %% ── 处方内部 ──
    处方主表 ||--o{ 处方明细 : "pm_id → 明细"
    医生 ||--o{ 处方主表 : "d_id → 开方"
    药品 ||--o{ 处方明细 : "dr_id → 用药"

    %% ── 检查 ──
    检查项目 ||--o{ 检查开单 : "ch_id"

    %% ── 第四层：执行 ──
    处方明细 ||--o{ 发药记录 : "presc_detail_id → 发药"

    %% ── 第五层：费用 ──
    处方主表 ||--o{ 缴费记录 : "pm_id → 缴药费"
    检查开单 ||--o{ 缴费记录 : "oc_id → 缴检查费"
    门诊病历 ||--o{ 缴费记录 : "emr_id → 缴诊查费"
    缴费记录 ||--o{ 发票 : "br_id → 开票"
    缴费记录 ||--o{ 退费申请 : "br_id → 退费"

    %% ── 辅助功能（保持简洁）──
    医生 ||--o{ 排班 : "d_id"
    医生 ||--o{ 处方模板 : "d_id"
    医生 ||--o{ 病历模板 : "d_id"
    患者 ||--o{ 消息通知 : "p_id"
