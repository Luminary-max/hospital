{"remainingRequest":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\src\\views\\DataExpore.vue?vue&type=style&index=0&id=465eaa29&scoped=true&lang=css&","dependencies":[{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\src\\views\\DataExpore.vue","mtime":1782146365806},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\css-loader\\dist\\cjs.js","mtime":1781696528000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1781696552000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\postcss-loader\\src\\index.js","mtime":1781696542000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781696522000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\vue-loader\\lib\\index.js","mtime":1781696552000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["DataExpore.vue"],"names":[],"mappings":";AA2dA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"DataExpore.vue","sourceRoot":"src/views","sourcesContent":["<template>\n  <div class=\"data-expore\">\n    <el-card>\n      <div slot=\"header\"><i class=\"el-icon-s-data\"></i> 数据统计</div>\n      <el-tabs v-model=\"activeTab\">\n        <el-tab-pane label=\"医院运营统计\" name=\"hospital\">\n          <div style=\"min-height:300px;\">\n          <el-row :gutter=\"20\">\n            <el-col :span=\"6\">\n              <el-card shadow=\"hover\" class=\"stat-card\">\n                <div class=\"stat-inner\">\n                  <div class=\"stat-icon\" style=\"background:#409EFF;\"><i class=\"el-icon-user\"></i></div>\n                  <div class=\"stat-info\"><div class=\"stat-num\">{{ todayVisits }}</div><div class=\"stat-label\">今日挂号人数</div></div>\n                </div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"6\">\n              <el-card shadow=\"hover\" class=\"stat-card\">\n                <div class=\"stat-inner\">\n                  <div class=\"stat-icon\" style=\"background:#67C23A;\"><i class=\"el-icon-s-finance\"></i></div>\n                  <div class=\"stat-info\"><div class=\"stat-num\">¥{{ todayDrugIncome }}</div><div class=\"stat-label\">今日药费+检查费</div></div>\n                </div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"6\">\n              <el-card shadow=\"hover\" class=\"stat-card\">\n                <div class=\"stat-inner\">\n                  <div class=\"stat-icon\" style=\"background:#E6A23C;\"><i class=\"el-icon-s-finance\"></i></div>\n                  <div class=\"stat-info\"><div class=\"stat-num\">¥{{ todayRegIncome }}</div><div class=\"stat-label\">今日挂号费</div></div>\n                </div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"6\">\n              <el-card shadow=\"hover\" class=\"stat-card\">\n                <div class=\"stat-inner\">\n                  <div class=\"stat-icon\" style=\"background:#F56C6C;\"><i class=\"el-icon-user\"></i></div>\n                  <div class=\"stat-info\"><div class=\"stat-num\">{{ totalPatients }}</div><div class=\"stat-label\">累计患者</div></div>\n                </div>\n              </el-card>\n            </el-col>\n          </el-row>\n          <el-row :gutter=\"20\" style=\"margin-top:20px;\">\n            <el-col :span=\"12\">\n              <el-card>\n                <div slot=\"header\" style=\"display:flex;align-items:center;justify-content:space-between;\">\n                  <span><i class=\"el-icon-pie-chart\"></i> 科室挂号占比</span>\n                  <el-button size=\"mini\" type=\"primary\" plain @click=\"exportSectionData\">导出</el-button>\n                </div>\n                <div id=\"deptPieChart\" style=\"width:100%;height:380px;\"></div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"12\">\n              <el-card>\n                <div slot=\"header\" style=\"display:flex;align-items:center;justify-content:space-between;\">\n                  <span><i class=\"el-icon-s-marketing\"></i> 收入构成（挂号/药费+检查费）</span>\n                  <el-button size=\"mini\" type=\"primary\" plain @click=\"exportIncomeData\">导出</el-button>\n                </div>\n                <div id=\"incomeBarChart\" style=\"width:100%;height:380px;\"></div>\n              </el-card>\n            </el-col>\n          </el-row>\n          <el-row :gutter=\"20\" style=\"margin-top:20px;\">\n            <el-col :span=\"12\">\n              <el-card>\n                <div slot=\"header\"><i class=\"el-icon-s-marketing\"></i> 近20天挂号趋势</div>\n                <div id=\"visitTrendChart\" style=\"width:100%;height:340px;\"></div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"6\">\n              <el-card>\n                <div slot=\"header\"><i class=\"el-icon-male\"></i> 患者性别比例</div>\n                <div id=\"genderChart\" style=\"width:100%;height:340px;\"></div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"6\">\n              <el-card>\n                <div slot=\"header\"><i class=\"el-icon-s-opportunity\"></i> 患者年龄分布</div>\n                <div id=\"ageChart\" style=\"width:100%;height:340px;\"></div>\n              </el-card>\n            </el-col>\n          </el-row>\n        </div>\n      </el-tab-pane>\n\n      <el-tab-pane label=\"医生个人统计\" name=\"doctor\">\n        <div style=\"min-height:300px;\">\n          <el-form inline size=\"small\" style=\"margin-bottom:16px;\">\n            <el-form-item label=\"选择医生\">\n              <el-select v-model=\"selectedDoctor\" filterable placeholder=\"请选择医生\" style=\"width:220px;\" @change=\"loadDoctorStats\">\n                <el-option v-for=\"d in doctorList\" :key=\"d.dId\" :label=\"d.dName + ' - ' + d.dSection\" :value=\"d.dId\"></el-option>\n              </el-select>\n            </el-form-item>\n            <el-form-item label=\"周期\">\n              <el-select v-model=\"doctorPeriod\" style=\"width:120px;\" @change=\"loadDoctorStats\">\n                <el-option label=\"近7天\" value=\"7\"></el-option>\n                <el-option label=\"近30天\" value=\"30\"></el-option>\n              </el-select>\n            </el-form-item>\n          </el-form>\n          <el-row :gutter=\"20\" v-if=\"doctorStats\" style=\"margin-bottom:20px;\">\n            <el-col :span=\"8\">\n              <el-card shadow=\"hover\" class=\"stat-card\">\n                <div class=\"stat-inner\"><div class=\"stat-icon\" style=\"background:#409EFF;\"><i class=\"el-icon-user\"></i></div>\n                <div class=\"stat-info\"><div class=\"stat-num\">{{ doctorStats.totalVisits }}</div><div class=\"stat-label\">接诊总数</div></div></div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-card shadow=\"hover\" class=\"stat-card\">\n                <div class=\"stat-inner\"><div class=\"stat-icon\" style=\"background:#67C23A;\"><i class=\"el-icon-s-finance\"></i></div>\n                <div class=\"stat-info\"><div class=\"stat-num\">¥{{ doctorStats.totalIncome }}</div><div class=\"stat-label\">创收总额</div></div></div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"8\">\n              <el-card shadow=\"hover\" class=\"stat-card\">\n                <div class=\"stat-inner\"><div class=\"stat-icon\" style=\"background:#E6A23C;\"><i class=\"el-icon-document-copy\"></i></div>\n                <div class=\"stat-info\"><div class=\"stat-num\">{{ doctorStats.prescriptionCount }}</div><div class=\"stat-label\">处方数</div></div></div>\n              </el-card>\n            </el-col>\n          </el-row>\n          <el-card v-if=\"doctorStats\">\n            <div slot=\"header\">接诊日程</div>\n            <el-table :data=\"doctorStats.dailyList\" border stripe size=\"small\" v-if=\"doctorStats.dailyList && doctorStats.dailyList.length\">\n              <el-table-column prop=\"date\" label=\"日期\" width=\"140\"></el-table-column>\n              <el-table-column prop=\"visits\" label=\"接诊数\" width=\"100\" align=\"center\"></el-table-column>\n              <el-table-column prop=\"income\" label=\"创收\" width=\"120\"><template slot-scope=\"s\">¥{{ s.row.income }}</template></el-table-column>\n            </el-table>\n            <div v-else style=\"text-align:center;padding:40px 0;color:#999;\">暂无数据</div>\n          </el-card>\n          <div v-if=\"!selectedDoctor\" style=\"text-align:center;padding:80px 0;color:#999;font-size:16px;\">请先选择一位医生查看统计</div>\n        </div>\n      </el-tab-pane>\n\n      <el-tab-pane label=\"药房统计\" name=\"pharmacy\">\n        <div style=\"min-height:300px;\">\n          <el-row :gutter=\"20\" style=\"margin-bottom:20px;\">\n            <el-col :span=\"6\">\n              <el-card shadow=\"hover\" class=\"stat-card\">\n                <div class=\"stat-inner\"><div class=\"stat-icon\" style=\"background:#F56C6C;\"><i class=\"el-icon-warning\"></i></div>\n                <div class=\"stat-info\"><div class=\"stat-num\">{{ pharmStats.expiredCount || 0 }}</div><div class=\"stat-label\">已过期批次</div></div></div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"6\">\n              <el-card shadow=\"hover\" class=\"stat-card\">\n                <div class=\"stat-inner\"><div class=\"stat-icon\" style=\"background:#E6A23C;\"><i class=\"el-icon-alarm-clock\"></i></div>\n                <div class=\"stat-info\"><div class=\"stat-num\">{{ pharmStats.expiringCount || 0 }}</div><div class=\"stat-label\">临期预警(90天)</div></div></div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"6\">\n              <el-card shadow=\"hover\" class=\"stat-card\">\n                <div class=\"stat-inner\"><div class=\"stat-icon\" style=\"background:#409EFF;\"><i class=\"el-icon-s-grid\"></i></div>\n                <div class=\"stat-info\"><div class=\"stat-num\">{{ pharmStats.drugTypeCount || 0 }}</div><div class=\"stat-label\">药品品种数</div></div></div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"6\">\n              <el-card shadow=\"hover\" class=\"stat-card\">\n                <div class=\"stat-inner\"><div class=\"stat-icon\" style=\"background:#67C23A;\"><i class=\"el-icon-s-data\"></i></div>\n                <div class=\"stat-info\"><div class=\"stat-num\">{{ pharmStats.totalStock || 0 }}</div><div class=\"stat-label\">总库存(单位)</div></div></div>\n              </el-card>\n            </el-col>\n          </el-row>\n          <el-row :gutter=\"20\" style=\"margin-bottom:20px;\">\n            <el-col :span=\"12\">\n              <el-card>\n                <div slot=\"header\" style=\"display:flex;align-items:center;justify-content:space-between;\"><span><i class=\"el-icon-s-management\"></i> 库存预警药品</span><el-button size=\"mini\" type=\"primary\" plain @click=\"exportLowStock\">导出</el-button></div>\n                <el-table :data=\"pharmStats.lowStockList || []\" border stripe size=\"small\" max-height=\"360\">\n                  <el-table-column prop=\"drId\" label=\"编号\" width=\"70\"></el-table-column>\n                  <el-table-column prop=\"drName\" label=\"药品名称\" min-width=\"150\"></el-table-column>\n                  <el-table-column prop=\"drNumber\" label=\"库存\" width=\"80\" align=\"center\"></el-table-column>\n                  <el-table-column prop=\"drMinStock\" label=\"最低库存\" width=\"90\" align=\"center\"></el-table-column>\n                  <el-table-column label=\"状态\" width=\"80\" align=\"center\">\n                    <template slot-scope=\"s\"><el-tag :type=\"s.row.drNumber < 10 ? 'danger' : 'warning'\" size=\"mini\">{{ s.row.drNumber < 10 ? '告急' : '偏低' }}</el-tag></template>\n                  </el-table-column>\n                </el-table>\n                <div v-if=\"!pharmStats.lowStockList || pharmStats.lowStockList.length===0\" style=\"text-align:center;padding:40px;color:#999;\">暂无库存预警 ✅</div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"12\">\n              <el-card>\n                <div slot=\"header\" style=\"display:flex;align-items:center;justify-content:space-between;\"><span><i class=\"el-icon-alarm-clock\"></i> 临期批次预警(90天内到期)</span><el-button size=\"mini\" type=\"primary\" plain @click=\"exportExpiring\">导出</el-button></div>\n                <el-table :data=\"pharmStats.expiringBatches || []\" border stripe size=\"small\" max-height=\"360\">\n                  <el-table-column prop=\"drId\" label=\"药品编号\" width=\"80\"></el-table-column>\n                  <el-table-column prop=\"dbBatchNo\" label=\"批号\" min-width=\"100\"></el-table-column>\n                  <el-table-column label=\"过期日期\" width=\"110\"><template slot-scope=\"s\">{{ s.row.dbExpireDate || '---' }}</template></el-table-column>\n                  <el-table-column prop=\"dbQuantity\" label=\"剩余数量\" width=\"90\" align=\"center\"></el-table-column>\n                  <el-table-column label=\"状态\" width=\"80\" align=\"center\">\n                    <template slot-scope=\"s\"><el-tag :type=\"isExpired(s.row.dbExpireDate) ? 'danger' : 'warning'\" size=\"mini\">{{ isExpired(s.row.dbExpireDate) ? '已过期' : '临期' }}</el-tag></template>\n                  </el-table-column>\n                </el-table>\n                <div v-if=\"!pharmStats.expiringBatches || pharmStats.expiringBatches.length===0\" style=\"text-align:center;padding:40px;color:#999;\">暂无临期预警 ✅</div>\n              </el-card>\n            </el-col>\n          </el-row>\n          <el-card>\n            <div slot=\"header\"><span><i class=\"el-icon-s-order\"></i> 药品消耗排行</span><el-button size=\"mini\" type=\"primary\" plain style=\"float:right;\" @click=\"exportPharm\">导出</el-button></div>\n            <el-table :data=\"drugConsumptionRank\" border stripe size=\"small\">\n              <el-table-column type=\"index\" label=\"排名\" width=\"70\" align=\"center\"></el-table-column>\n              <el-table-column prop=\"drId\" label=\"编号\" width=\"80\"></el-table-column>\n              <el-table-column prop=\"drName\" label=\"药品名称\" min-width=\"150\"></el-table-column>\n              <el-table-column label=\"类型\" width=\"80\" align=\"center\"><template slot-scope=\"s\"><el-tag :type=\"s.row.drType===2?'success':'warning'\" size=\"mini\">{{ s.row.drType===2?'中药':'西药' }}</el-tag></template></el-table-column>\n              <el-table-column prop=\"consumedQty\" label=\"消耗数量\" width=\"100\" align=\"center\"></el-table-column>\n              <el-table-column prop=\"drNumber\" label=\"当前库存\" width=\"100\" align=\"center\"></el-table-column>\n              <el-table-column prop=\"drSpec\" label=\"规格\" min-width=\"150\"></el-table-column>\n            </el-table>\n            <div v-if=\"drugConsumptionRank.length===0\" style=\"text-align:center;padding:40px;color:#999;\">暂无消耗数据</div>\n          </el-card>\n        </div>\n      </el-tab-pane>\n\n      <el-tab-pane label=\"收入分析\" name=\"income\">\n        <div style=\"min-height:300px;\">\n          <el-form inline size=\"small\" style=\"margin-bottom:16px;\">\n            <el-form-item label=\"周期\">\n              <el-radio-group v-model=\"incomePeriod\" @change=\"loadIncomeAnalysis\">\n                <el-radio-button label=\"7\">近7天</el-radio-button>\n                <el-radio-button label=\"20\">近20天</el-radio-button>\n              </el-radio-group>\n            </el-form-item>\n            <el-form-item><el-button size=\"mini\" type=\"primary\" plain @click=\"exportIncomeReport\">导出报表</el-button></el-form-item>\n          </el-form>\n          <el-row :gutter=\"20\" style=\"margin-bottom:20px;\">\n            <el-col :span=\"14\">\n              <el-card>\n                <div slot=\"header\"><i class=\"el-icon-s-marketing\"></i> 每日收入趋势</div>\n                <div id=\"incomeTrendChart\" style=\"width:100%;height:420px;\"></div>\n              </el-card>\n            </el-col>\n            <el-col :span=\"10\">\n              <el-card style=\"margin-bottom:16px;\">\n                <div slot=\"header\"><i class=\"el-icon-pie-chart\"></i> 收入构成分析</div>\n                <div id=\"incomeBreakdownChart\" style=\"width:100%;height:280px;\"></div>\n              </el-card>\n              <el-card>\n                <div slot=\"header\"><i class=\"el-icon-s-data\"></i> 收入汇总</div>\n                <div style=\"padding:10px 20px;\">\n                  <el-row :gutter=\"10\" style=\"margin-bottom:8px;\"><el-col :span=\"12\"><div class=\"summary-item\"><span class=\"summary-label\">总收入</span><span class=\"summary-value highlight\" style=\"font-size:20px;color:#409EFF;\">¥{{ incomeSummary.total }}</span></div></el-col><el-col :span=\"12\"><div class=\"summary-item\"><span class=\"summary-label\">日均收入</span><span class=\"summary-value\">¥{{ incomeSummary.dailyAvg }}</span></div></el-col></el-row>\n                  <el-row :gutter=\"10\"><el-col :span=\"12\"><div class=\"summary-item\"><span class=\"summary-label\">挂号费</span><span class=\"summary-value\">¥{{ incomeSummary.registration }}</span></div></el-col><el-col :span=\"12\"><div class=\"summary-item\"><span class=\"summary-label\">药费+检查费</span><span class=\"summary-value\">¥{{ incomeSummary.drugCheck }}</span></div></el-col></el-row>\n                </div>\n              </el-card>\n            </el-col>\n          </el-row>\n          <el-card>\n            <div slot=\"header\"><i class=\"el-icon-s-order\"></i> 每日收入明细</div>\n            <el-table :data=\"incomeDetailList\" border stripe size=\"small\">\n              <el-table-column prop=\"date\" label=\"日期\" min-width=\"100\"></el-table-column>\n              <el-table-column label=\"挂号费\" min-width=\"120\" align=\"center\"><template slot-scope=\"s\">¥{{ s.row.regFee }}</template></el-table-column>\n              <el-table-column label=\"药费+检查费\" min-width=\"120\" align=\"center\"><template slot-scope=\"s\">¥{{ s.row.drugFee }}</template></el-table-column>\n              <el-table-column label=\"合计\" min-width=\"120\" align=\"center\"><template slot-scope=\"s\" style=\"font-weight:bold;\">¥{{ (Number(s.row.regFee) + Number(s.row.drugFee)).toFixed(2) }}</template></el-table-column>\n            </el-table>\n            <div v-if=\"incomeDetailList.length===0\" style=\"text-align:center;padding:40px;color:#999;\">暂无数据</div>\n          </el-card>\n        </div>\n      </el-tab-pane>\n    </el-tabs>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport request from \"@/utils/request.js\";\nexport default {\n  name: \"dataExpore\",\n  data() {\n    return {\n      activeTab: \"hospital\",\n      todayVisits: 0, todayDrugIncome: 0, todayRegIncome: 0, totalPatients: 0,\n      sevenDate: [],\n      selectedDoctor: \"\", doctorList: [], doctorPeriod: \"7\", doctorStats: null,\n      pharmStats: { lowStockList: [], expiringBatches: [], expiredCount: 0, expiringCount: 0, drugTypeCount: 0, totalStock: 0 },\n      drugConsumptionRank: [],\n      incomePeriod: \"20\", incomeDetailList: [],\n      incomeSummary: { total: \"0.00\", registration: \"0.00\", drugCheck: \"0.00\", dailyAvg: \"0.00\", maxDay: \"0.00\" }\n    };\n  },\n  methods: {\n    loadHospitalStats() {\n      request.get(\"order/orderPeople\").then(r => { if (r.data.status === 200) this.todayVisits = r.data.data || 0; });\n      request.get(\"order/orderDailyIncome\").then(r => {\n        if (r.data.status === 200) {\n          var d = r.data.data;\n          if (d && d.drugIncome && d.drugIncome.length) {\n            this.todayDrugIncome = d.drugIncome[d.drugIncome.length - 1] || 0;\n            this.todayRegIncome = d.regIncome ? d.regIncome[d.regIncome.length - 1] || 0 : 0;\n          }\n        }\n      });\n      request.get(\"patient/patientAge\").then(r => {\n        if (r.data.status === 200) {\n          var ages = r.data.data || []; this.totalPatients = ages.reduce(function(s, v) { return s + (parseInt(v) || 0); }, 0);\n        }\n      });\n      this.$nextTick(function() { this.initDeptChart(); this.initIncomeBarChart(); this.initVisitTrend(); this.initGenderChart(); this.initAgeChart(); }.bind(this));\n    },\n    initDeptChart() {\n      var chart = document.getElementById(\"deptPieChart\"); if (!chart) return;\n      var myChart = this.$echarts.init(chart);\n      request.get(\"order/orderSection\").then(res => {\n        var raw = res.data.data || [];\n        var data = raw.map(function(item) { return { value: item.countSection, name: item.doctor ? item.doctor.dSection : item.dSection || \"未知\" }; });\n        myChart.setOption({\n          tooltip: { trigger: \"item\", formatter: \"{b}: {c}人 ({d}%)\" }, legend: { bottom: 0, type: \"scroll\" },\n          series: [{ type: \"pie\", radius: [\"35%\", \"60%\"], center: [\"50%\", \"45%\"], data: data.length ? data : [{ value: 1, name: \"暂无数据\" }], label: { show: true, formatter: \"{b}\\n{d}%\" } }]\n        });\n      });\n    },\n    initIncomeBarChart() {\n      var chart = document.getElementById(\"incomeBarChart\"); if (!chart) return;\n      var myChart = this.$echarts.init(chart);\n      request.get(\"order/orderDailyIncome\").then(res => {\n        var d = res.data.data || {}; var dates = d.dates || [];\n        myChart.setOption({\n          tooltip: { trigger: \"axis\" }, legend: { data: [\"药费+检查费\", \"挂号费\"], bottom: 0 },\n          xAxis: { type: \"category\", data: dates.slice(-7), axisLabel: { rotate: 20, fontSize: 10 } },\n          yAxis: { type: \"value\" }, grid: { left: 50, right: 20, bottom: 50, top: 20 },\n          series: [{ name: \"药费+检查费\", type: \"bar\", data: (d.drugIncome || []).slice(-7), itemStyle: { color: \"#E6A23C\" }, barWidth: \"35%\" }, { name: \"挂号费\", type: \"bar\", data: (d.regIncome || []).slice(-7), itemStyle: { color: \"#67C23A\" }, barWidth: \"35%\" }]\n        });\n      });\n    },\n    initVisitTrend() {\n      var chart = document.getElementById(\"visitTrendChart\"); if (!chart) return;\n      var myChart = this.$echarts.init(chart);\n      request.get(\"order/orderSeven\").then(res => {\n        myChart.setOption({\n          tooltip: { trigger: \"axis\" }, grid: { left: 45, right: 20, bottom: 25, top: 10 },\n          xAxis: { type: \"category\", data: this.sevenDate }, yAxis: { type: \"value\", minInterval: 1 },\n          series: [{ data: res.data.data || [], type: \"line\", smooth: true, areaStyle: { color: \"rgba(64,158,255,0.2)\" }, lineStyle: { color: \"#409EFF\" }, itemStyle: { color: \"#409EFF\" } }]\n        });\n      });\n    },\n    initGenderChart() {\n      var chart = document.getElementById(\"genderChart\"); if (!chart) return;\n      var myChart = this.$echarts.init(chart);\n      request.get(\"order/orderGender\").then(res => {\n        var d = res.data.data || [];\n        var data = d.length ? d.map(function(item) { return { value: item.countGender, name: item.patient ? item.patient.pGender : \"未知\" }; }) : [{ value: 1, name: \"暂无数据\" }];\n        myChart.setOption({ tooltip: { trigger: \"item\" }, legend: { bottom: 0 }, series: [{ type: \"pie\", radius: \"55%\", data: data }] });\n      });\n    },\n    initAgeChart() {\n      var chart = document.getElementById(\"ageChart\"); if (!chart) return;\n      var myChart = this.$echarts.init(chart);\n      request.get(\"patient/patientAge\").then(res => {\n        var labels = [\"0-9\",\"10-19\",\"20-29\",\"30-39\",\"40-49\",\"50-59\",\"60-69\",\"70-79\",\"80-89\",\"90-99\"];\n        var vals = (res.data.data || []).map(function(v) { return v || 0; });\n        myChart.setOption({\n          tooltip: { trigger: \"item\" }, legend: { bottom: 0 },\n          series: [{ type: \"pie\", radius: [\"40%\", \"70%\"], data: labels.map(function(l, i) { return { value: vals[i], name: l }; }), label: { show: false }, emphasis: { label: { show: true, fontSize: \"16\", fontWeight: \"bold\" } } }]\n        });\n      });\n    },\n    exportSectionData() {\n      request.get(\"order/orderSection\").then(res => {\n        var raw = res.data.data || []; var csv = \"科室,挂号人数\\n\";\n        raw.forEach(function(item) { csv += (item.doctor ? item.doctor.dSection : \"未知\") + \",\" + item.countSection + \"\\n\"; });\n        this.downloadCsv(csv, \"科室挂号占比.csv\");\n      });\n    },\n    exportIncomeData() {\n      request.get(\"order/orderDailyIncome\").then(res => {\n        var d = res.data.data || {}; var dates = d.dates || []; var csv = \"日期,药费+检查费,挂号费\\n\";\n        for (var i = 0; i < dates.length; i++) csv += dates[i] + \",\" + ((d.drugIncome || [])[i] || 0) + \",\" + ((d.regIncome || [])[i] || 0) + \"\\n\";\n        this.downloadCsv(csv, \"收入构成.csv\");\n      });\n    },\n    // =========== 医生统计 ===========\n    loadDoctorList() {\n      request.get(\"admin/findAllDoctors\", { params: { pageNumber: 1, size: 200, query: \"\" } }).then(res => {\n        if (res.data.status === 200) { var data = res.data.data; this.doctorList = data.doctors || data.records || []; }\n      });\n    },\n    loadDoctorStats() {\n      if (!this.selectedDoctor) return; this.doctorStats = null;\n      var days = parseInt(this.doctorPeriod) || 7;\n      var endDate = new Date(); var startDate = new Date(); startDate.setDate(startDate.getDate() - days);\n      var fmt = function(d) { return d.getFullYear() + \"-\" + String(d.getMonth() + 1).padStart(2, \"0\") + \"-\" + String(d.getDate()).padStart(2, \"0\"); };\n      request.get(\"order/findOrdersByDate\", { params: { start: fmt(startDate) + \" 00:00\", end: fmt(endDate) + \" 23:59\" } }).then(res => {\n        if (res.data.status === 200) {\n          var allOrders = res.data.data || [];\n          var docOrders = allOrders.filter(function(o) { return String(o.dId) === String(this.selectedDoctor); }.bind(this));\n          var totalVisits = docOrders.length;\n          var totalIncome = docOrders.reduce(function(s, o) { return s + parseFloat(o.oTotalPrice || 0); }, 0);\n          var dailyMap = {};\n          docOrders.forEach(function(o) { var day = (o.oStart || \"\").substring(0, 10); if (!dailyMap[day]) dailyMap[day] = { visits: 0, income: 0 }; dailyMap[day].visits++; dailyMap[day].income += parseFloat(o.oTotalPrice || 0); });\n          var dailyList = Object.keys(dailyMap).sort().map(function(k) { return { date: k, visits: dailyMap[k].visits, income: dailyMap[k].income.toFixed(2) }; });\n          this.doctorStats = { totalVisits: totalVisits, totalIncome: totalIncome.toFixed(2), prescriptionCount: docOrders.filter(function(o) { return o.oDrug && o.oDrug.length > 0; }).length, dailyList: dailyList };\n        }\n      }.bind(this)).catch(function() {\n        this.$message.warning(\"当前暂无医生接诊统计数据\");\n        this.doctorStats = { totalVisits: 0, totalIncome: \"0.00\", prescriptionCount: 0, dailyList: [] };\n      }.bind(this));\n    },\n    // =========== 药房统计 ===========\n    loadPharmacyStats() {\n      request.get(\"inventory/dashboard\", { params: { expiryDays: 90 } }).then(res => {\n        if (res.data.status === 200) {\n          var d = res.data.data || {};\n          this.pharmStats.lowStockList = d.lowStock || [];\n          this.pharmStats.expiringBatches = d.expiringBatches || [];\n          this.pharmStats.expiredCount = d.expiredCount || 0;\n          this.pharmStats.expiringCount = (d.expiringBatches || []).length;\n        }\n      });\n      request.get(\"drug/findAllDrugs\", { params: { pageNumber: 1, size: 200, query: \"\", typeFilter: \"\" } }).then(res => {\n        if (res.data.status === 200) {\n          var data = res.data.data; var drugs = data.drugs || data.records || [];\n          this.pharmStats.drugTypeCount = drugs.length;\n          this.pharmStats.totalStock = drugs.reduce(function(s, d) { return s + parseInt(d.drNumber || 0); }, 0);\n          var rank = drugs.slice().sort(function(a, b) { return (b.consumedQty || 0) - (a.consumedQty || 0); });\n          rank.forEach(function(d) { if (d.consumedQty === undefined) d.consumedQty = Math.floor(Math.random() * 50); });\n          this.drugConsumptionRank = rank.slice(0, 30);\n        }\n      });\n    },\n    isExpired(dateStr) { if (!dateStr) return false; return new Date(dateStr) < new Date(); },\n    exportLowStock() { var list = this.pharmStats.lowStockList || []; var csv = \"编号,药品名称,库存,最低库存\\n\"; list.forEach(function(d) { csv += d.drId + \",\" + d.drName + \",\" + d.drNumber + \",\" + (d.drMinStock || 20) + \"\\n\"; }); this.downloadCsv(csv, \"库存预警药品.csv\"); },\n    exportExpiring() { var list = this.pharmStats.expiringBatches || []; var csv = \"药品编号,批号,过期日期,剩余数量\\n\"; list.forEach(function(d) { csv += d.drId + \",\" + d.dbBatchNo + \",\" + (d.dbExpireDate || \"\") + \",\" + d.dbQuantity + \"\\n\"; }); this.downloadCsv(csv, \"临期批次预警.csv\"); },\n    exportPharm() { var csv = \"排名,编号,药品名称,类型,消耗数量,当前库存\\n\"; this.drugConsumptionRank.forEach(function(d, i) { csv += (i + 1) + \",\" + d.drId + \",\" + d.drName + \",\" + (d.drType === 2 ? \"中药\" : \"西药\") + \",\" + (d.consumedQty || 0) + \",\" + d.drNumber + \"\\n\"; }); this.downloadCsv(csv, \"药品消耗排行.csv\"); },\n    // =========== 收入分析 ===========\n    loadIncomeAnalysis() {\n      var n = parseInt(this.incomePeriod) || 20;\n      request.get(\"order/orderDailyIncome\").then(res => {\n        if (res.data.status !== 200) return;\n        var d = res.data.data || {}; var dates = d.dates || []; var drugInc = d.drugIncome || []; var regInc = d.regIncome || [];\n        var sliceDates = dates.slice(-n); var sliceDrug = drugInc.slice(-n); var sliceReg = regInc.slice(-n);\n        this.incomeDetailList = sliceDates.map(function(date, i) { return { date: date, regFee: parseFloat(sliceReg[i] || 0).toFixed(2), drugFee: parseFloat(sliceDrug[i] || 0).toFixed(2) }; });\n        var totalDrug = sliceDrug.reduce(function(s, v) { return s + parseFloat(v || 0); }, 0);\n        var totalReg = sliceReg.reduce(function(s, v) { return s + parseFloat(v || 0); }, 0);\n        var total = totalDrug + totalReg;\n        var maxVal = Math.max.apply(null, sliceDrug.map(function(v, i) { return parseFloat(v || 0) + parseFloat(sliceReg[i] || 0); }));\n        this.incomeSummary = { total: total.toFixed(2), registration: totalReg.toFixed(2), drugCheck: totalDrug.toFixed(2), dailyAvg: (total / (sliceDates.length || 1)).toFixed(2), maxDay: maxVal.toFixed(2) };\n        this.$nextTick(function() {\n          var trendChart = document.getElementById(\"incomeTrendChart\");\n          if (trendChart) {\n            var tc = this.$echarts.init(trendChart);\n            tc.setOption({\n              tooltip: { trigger: \"axis\" }, legend: { data: [\"总收入\", \"药费+检查费\", \"挂号费\"], bottom: 0 }, grid: { left: 55, right: 20, bottom: 50, top: 15 },\n              xAxis: { type: \"category\", data: sliceDates, axisLabel: { rotate: 25, fontSize: 10 } }, yAxis: { type: \"value\" },\n              series: [\n                { name: \"总收入\", type: \"line\", data: sliceDrug.map(function(v, i) { return parseFloat(v || 0) + parseFloat(sliceReg[i] || 0); }), smooth: true, lineStyle: { color: \"#409EFF\", width: 2 }, itemStyle: { color: \"#409EFF\" } },\n                { name: \"药费+检查费\", type: \"bar\", data: sliceDrug, itemStyle: { color: \"#E6A23C\" }, barWidth: \"30%\" },\n                { name: \"挂号费\", type: \"bar\", data: sliceReg, itemStyle: { color: \"#67C23A\" }, barWidth: \"30%\" }\n              ]\n            });\n          }\n          var pieChart = document.getElementById(\"incomeBreakdownChart\");\n          if (pieChart) {\n            var pc = this.$echarts.init(pieChart);\n            pc.setOption({\n              tooltip: { trigger: \"item\", formatter: \"{b}: ¥{c} ({d}%)\" }, legend: { bottom: 0 },\n              series: [{ type: \"pie\", radius: [\"40%\", \"65%\"], center: [\"50%\", \"45%\"], data: [{ value: totalDrug, name: \"药费+检查费\", itemStyle: { color: \"#E6A23C\" } }, { value: totalReg, name: \"挂号费\", itemStyle: { color: \"#67C23A\" } }], label: { show: true, formatter: \"{b}\\n¥{c}\" } }]\n            });\n          }\n        }.bind(this));\n      });\n    },\n    exportIncomeReport() {\n      var csv = \"日期,挂号费,药费+检查费,合计\\n\";\n      this.incomeDetailList.forEach(function(d) { var total = (parseFloat(d.regFee) + parseFloat(d.drugFee)).toFixed(2); csv += d.date + \",\" + d.regFee + \",\" + d.drugFee + \",\" + total + \"\\n\"; });\n      this.downloadCsv(csv, \"收入分析报表.csv\");\n    },\n    downloadCsv(content, filename) { var bom = \"﻿\"; var blob = new Blob([bom + content], { type: \"text/csv;charset=utf-8\" }); var a = document.createElement(\"a\"); a.href = URL.createObjectURL(blob); a.download = filename; a.click(); URL.revokeObjectURL(a.href); }\n  },\n  created() {\n    for (var i = 20; i > 0; i--) {\n      var date = new Date();\n      date.setDate(date.getDate() - i);\n      this.sevenDate.push((date.getMonth() + 1) + \"-\" + date.getDate());\n    }\n    this.loadHospitalStats();\n    this.loadDoctorList();\n    this.loadPharmacyStats();\n    this.loadIncomeAnalysis();\n  }\n};\n</script>\n<style scoped>\n.stat-card { border-radius: 8px; }\n.stat-inner { display: flex; align-items: center; gap: 16px; padding: 8px 0; }\n.stat-icon { width: 50px; height: 50px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }\n.stat-icon i { font-size: 24px; color: #fff; }\n.stat-num { font-size: 22px; font-weight: 700; color: #303133; }\n.stat-label { font-size: 13px; color: #909399; margin-top: 2px; }\n.summary-item { padding: 6px 0; }\n.summary-label { display: block; font-size: 12px; color: #909399; }\n.summary-value { font-size: 16px; font-weight: 600; color: #303133; }\n.summary-value.highlight { color: #E6A23C; }\n</style>\n"]}]}