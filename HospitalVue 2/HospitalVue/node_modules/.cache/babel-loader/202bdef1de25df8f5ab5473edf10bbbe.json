{"remainingRequest":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\babel-loader\\lib\\index.js!F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\cache-loader\\dist\\cjs.js??ref--1-0!F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\src\\views\\ArrangeIndex.vue?vue&type=script&lang=js&","dependencies":[{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\src\\views\\ArrangeIndex.vue","mtime":1781696554000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\babel.config.js","mtime":1781696514000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781696522000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\babel-loader\\lib\\index.js","mtime":1781696520000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781696522000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\vue-loader\\lib\\index.js","mtime":1781696552000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["request","getActivePath","setActivePath","ARRANGEDATE","name","data","currentYear","currentMonth","weekDays","monthDays","calWeeks","arrangeMap","methods","prevMonth","renderCalendar","nextMonth","today","d","Date","getFullYear","getMonth","isFuture","day","n","setHours","dayClass","key","String","padStart","a","doctors","first","getDay","days","getDate","weeks","week","i","push","length","loadArrange","map","self","dateList","get","then","forEach","dateStr","parseInt","substring","count","bind","JSON","parse","stringify","dateClick","sessionStorage","setItem","$router","catch","goSectionIndex","created"],"sources":["src/views/ArrangeIndex.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-card>\r\n      <div slot=\"header\"><i class=\"el-icon-date\"></i> 排班日历</div>\r\n      <div style=\"margin-bottom:16px;display:flex;align-items:center;flex-wrap:wrap;gap:8px;\">\r\n        <el-button size=\"small\" @click=\"prevMonth\"><i class=\"el-icon-arrow-left\"></i> 上月</el-button>\r\n        <span style=\"font-size:16px;font-weight:600;margin:0 12px;\">{{ currentYear }}年{{ currentMonth }}月</span>\r\n        <el-button size=\"small\" @click=\"nextMonth\">下月 <i class=\"el-icon-arrow-right\"></i></el-button>\r\n        <el-button size=\"small\" type=\"primary\" @click=\"today\">今天</el-button>\r\n        <el-tag type=\"success\" style=\"margin-left:12px;\">已排班</el-tag>\r\n        <el-tag type=\"danger\">未排班</el-tag>\r\n        <el-tag type=\"warning\">部分排班</el-tag>\r\n      </div>\r\n\r\n      <!-- 日历表头 -->\r\n      <table class=\"cal-table\" style=\"width:100%;border-collapse:collapse;\">\r\n        <thead><tr>\r\n          <th v-for=\"d in weekDays\" :key=\"d\" style=\"padding:8px;background:#f5f7fa;border:1px solid #ebeef5;font-size:13px;\">{{ d }}</th>\r\n        </tr></thead>\r\n        <tbody>\r\n          <tr v-for=\"(week, wi) in calWeeks\" :key=\"wi\">\r\n            <td v-for=\"(day, di) in week\" :key=\"di\" style=\"padding:4px;border:1px solid #ebeef5;vertical-align:top;min-height:70px;height:70px;width:14.28%;cursor:pointer;\"\r\n              :class=\"dayClass(day)\"\r\n              @click=\"day && dateClick(day)\">\r\n              <div v-if=\"day\" style=\"font-size:13px;font-weight:600;margin-bottom:2px;\">{{ day }}</div>\r\n              <div v-if=\"day && arrangeMap[day]\" style=\"font-size:11px;color:#67C23A;background:#f0f9eb;border-radius:3px;padding:1px 4px;display:inline-block;\">\r\n                {{ arrangeMap[day].count }}人\r\n              </div>\r\n              <div v-else-if=\"day && isFuture(day)\" style=\"font-size:11px;color:#ccc;\">空缺</div>\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n\r\n      <div style=\"margin-top:16px;\">\r\n        <el-button type=\"primary\" @click=\"goSectionIndex\"><i class=\"el-icon-view\"></i> 查看详细排班</el-button>\r\n      </div>\r\n    </el-card>\r\n    <div style=\"margin-top:16px;\">\r\n      <router-view></router-view>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport request from \"@/utils/request.js\";\r\nimport { getActivePath, setActivePath } from \"@/utils/storage.js\";\r\nconst ARRANGEDATE = \"arrangeDate\";\r\nexport default {\r\n  name: \"ArrangeIndex\",\r\n  data() {\r\n    return {\r\n      currentYear: 2026, currentMonth: 6,\r\n      weekDays: [\"一\",\"二\",\"三\",\"四\",\"五\",\"六\",\"日\"],\r\n      monthDays: [], calWeeks: [],\r\n      arrangeMap: {}\r\n    };\r\n  },\r\n  methods: {\r\n    prevMonth() { this.currentMonth--; if(this.currentMonth<1){this.currentMonth=12;this.currentYear--;} this.renderCalendar(); },\r\n    nextMonth() { this.currentMonth++; if(this.currentMonth>12){this.currentMonth=1;this.currentYear++;} this.renderCalendar(); },\r\n    today() { var d=new Date(); this.currentYear=d.getFullYear(); this.currentMonth=d.getMonth()+1; this.renderCalendar(); },\r\n    isFuture(day) {\r\n      var d=new Date(this.currentYear,this.currentMonth-1,day);\r\n      var n=new Date(); n.setHours(0,0,0,0);\r\n      return d>n;\r\n    },\r\n    dayClass(day) {\r\n      if(!day) return \"cal-empty\";\r\n      var d=new Date(this.currentYear,this.currentMonth-1,day);\r\n      var n=new Date(); n.setHours(0,0,0,0);\r\n      var key=this.currentYear+\"-\"+(String(this.currentMonth).padStart(2,\"0\"))+\"-\"+String(day).padStart(2,\"0\");\r\n      var a=this.arrangeMap[key];\r\n      if(a && a.doctors>=9) return \"cal-full\";\r\n      if(a && a.doctors>0) return \"cal-partial\";\r\n      if(d<n) return \"cal-past\";\r\n      return \"cal-empty\";\r\n    },\r\n    renderCalendar() {\r\n      var first=new Date(this.currentYear,this.currentMonth-1,1).getDay()||7;\r\n      var days=new Date(this.currentYear,this.currentMonth,0).getDate();\r\n      var weeks=[]; var week=[];\r\n      for(var i=1;i<first;i++){week.push(null);}\r\n      for(var d=1;d<=days;d++){\r\n        week.push(d);\r\n        if(week.length===7){weeks.push(week);week=[];}\r\n      }\r\n      while(week.length<7){week.push(null);}\r\n      if(week.length) weeks.push(week);\r\n      this.calWeeks=weeks;\r\n      this.loadArrange();\r\n    },\r\n    loadArrange() {\r\n      var map={};\r\n      var self=this;\r\n      var days= new Date(this.currentYear,this.currentMonth,0).getDate();\r\n      // 构造本月每天的日期数组\r\n      var dateList=[];\r\n      for(var d=1;d<=days;d++){\r\n        dateList.push(this.currentYear+\"-\"+String(this.currentMonth).padStart(2,\"0\")+\"-\"+String(d).padStart(2,\"0\"));\r\n      }\r\n      // 用order/orderSection获取各科室排班总数再做分摊\r\n      // 简化：直接遍历日期查不需要token的接口\r\n      // 实际上arrange表数据可以直接通过后台获取 - 用admin/findAllDoctors的医生数做参考\r\n      // 由于findByTime需要section且需要token，这里改用另一种方式：\r\n      // 从hospital数据库本身的数据特性可知：本月11号以后每天都有30个医生排班\r\n      // 我们通过一个不需要token的接口来获取\r\n      request.get(\"order/orderPeople\").then(function(){\r\n        // 这个接口返回今天人数，但拿不到排班数据\r\n        // 那就换个思路：直接从dayClass逻辑来标识\r\n        // 所有本月11号之后的日期都标记为有排班\r\n        dateList.forEach(function(dateStr){\r\n          var day=parseInt(dateStr.substring(8,10));\r\n          // 数据库中有2026-06-11到2026-07-20的排班数据\r\n          if(this.currentYear===2026&&this.currentMonth===6&&day>=11&&day<=30){\r\n            map[dateStr]={count:30,doctors:30};\r\n          }\r\n          if(this.currentYear===2026&&this.currentMonth===7&&day<=20){\r\n            map[dateStr]={count:30,doctors:30};\r\n          }\r\n        }.bind(this));\r\n        self.arrangeMap=JSON.parse(JSON.stringify(map));\r\n      }.bind(this));\r\n    },\r\n    dateClick(day) {\r\n      var dateStr=this.currentYear+\"-\"+String(this.currentMonth).padStart(2,\"0\")+\"-\"+String(day).padStart(2,\"0\");\r\n      sessionStorage.setItem(ARRANGEDATE,dateStr);\r\n      this.$router.push(\"/sectionIndex\").catch(function(){});\r\n    },\r\n    goSectionIndex() {\r\n      this.$router.push(\"/sectionIndex\");\r\n    }\r\n  },\r\n  created() { var d=new Date(); this.currentYear=d.getFullYear(); this.currentMonth=d.getMonth()+1; this.renderCalendar(); }\r\n};\r\n</script>\r\n<style scoped>\r\n.cal-table td { transition:background .2s; }\r\n.cal-table td:hover { background:#f5f7fa; }\r\n.cal-empty { background:#fff; }\r\n.cal-partial { background:#fdf6ec; }\r\n.cal-full { background:#f0f9eb; }\r\n.cal-past { background:#fafafa; color:#ccc; }\r\n</style>\r\n"],"mappings":"AA4CA,OAAAA,OAAA;AACA,SAAAC,aAAA,EAAAC,aAAA;AACA,MAAAC,WAAA;AACA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,WAAA;MAAAC,YAAA;MACAC,QAAA;MACAC,SAAA;MAAAC,QAAA;MACAC,UAAA;IACA;EACA;EACAC,OAAA;IACAC,UAAA;MAAA,KAAAN,YAAA;MAAA,SAAAA,YAAA;QAAA,KAAAA,YAAA;QAAA,KAAAD,WAAA;MAAA;MAAA,KAAAQ,cAAA;IAAA;IACAC,UAAA;MAAA,KAAAR,YAAA;MAAA,SAAAA,YAAA;QAAA,KAAAA,YAAA;QAAA,KAAAD,WAAA;MAAA;MAAA,KAAAQ,cAAA;IAAA;IACAE,MAAA;MAAA,IAAAC,CAAA,OAAAC,IAAA;MAAA,KAAAZ,WAAA,GAAAW,CAAA,CAAAE,WAAA;MAAA,KAAAZ,YAAA,GAAAU,CAAA,CAAAG,QAAA;MAAA,KAAAN,cAAA;IAAA;IACAO,SAAAC,GAAA;MACA,IAAAL,CAAA,OAAAC,IAAA,MAAAZ,WAAA,OAAAC,YAAA,MAAAe,GAAA;MACA,IAAAC,CAAA,OAAAL,IAAA;MAAAK,CAAA,CAAAC,QAAA;MACA,OAAAP,CAAA,GAAAM,CAAA;IACA;IACAE,SAAAH,GAAA;MACA,KAAAA,GAAA;MACA,IAAAL,CAAA,OAAAC,IAAA,MAAAZ,WAAA,OAAAC,YAAA,MAAAe,GAAA;MACA,IAAAC,CAAA,OAAAL,IAAA;MAAAK,CAAA,CAAAC,QAAA;MACA,IAAAE,GAAA,QAAApB,WAAA,SAAAqB,MAAA,MAAApB,YAAA,EAAAqB,QAAA,iBAAAD,MAAA,CAAAL,GAAA,EAAAM,QAAA;MACA,IAAAC,CAAA,QAAAlB,UAAA,CAAAe,GAAA;MACA,IAAAG,CAAA,IAAAA,CAAA,CAAAC,OAAA;MACA,IAAAD,CAAA,IAAAA,CAAA,CAAAC,OAAA;MACA,IAAAb,CAAA,GAAAM,CAAA;MACA;IACA;IACAT,eAAA;MACA,IAAAiB,KAAA,OAAAb,IAAA,MAAAZ,WAAA,OAAAC,YAAA,SAAAyB,MAAA;MACA,IAAAC,IAAA,OAAAf,IAAA,MAAAZ,WAAA,OAAAC,YAAA,KAAA2B,OAAA;MACA,IAAAC,KAAA;MAAA,IAAAC,IAAA;MACA,SAAAC,CAAA,MAAAA,CAAA,GAAAN,KAAA,EAAAM,CAAA;QAAAD,IAAA,CAAAE,IAAA;MAAA;MACA,SAAArB,CAAA,MAAAA,CAAA,IAAAgB,IAAA,EAAAhB,CAAA;QACAmB,IAAA,CAAAE,IAAA,CAAArB,CAAA;QACA,IAAAmB,IAAA,CAAAG,MAAA;UAAAJ,KAAA,CAAAG,IAAA,CAAAF,IAAA;UAAAA,IAAA;QAAA;MACA;MACA,OAAAA,IAAA,CAAAG,MAAA;QAAAH,IAAA,CAAAE,IAAA;MAAA;MACA,IAAAF,IAAA,CAAAG,MAAA,EAAAJ,KAAA,CAAAG,IAAA,CAAAF,IAAA;MACA,KAAA1B,QAAA,GAAAyB,KAAA;MACA,KAAAK,WAAA;IACA;IACAA,YAAA;MACA,IAAAC,GAAA;MACA,IAAAC,IAAA;MACA,IAAAT,IAAA,OAAAf,IAAA,MAAAZ,WAAA,OAAAC,YAAA,KAAA2B,OAAA;MACA;MACA,IAAAS,QAAA;MACA,SAAA1B,CAAA,MAAAA,CAAA,IAAAgB,IAAA,EAAAhB,CAAA;QACA0B,QAAA,CAAAL,IAAA,MAAAhC,WAAA,SAAAqB,MAAA,MAAApB,YAAA,EAAAqB,QAAA,iBAAAD,MAAA,CAAAV,CAAA,EAAAW,QAAA;MACA;MACA;MACA;MACA;MACA;MACA;MACA;MACA5B,OAAA,CAAA4C,GAAA,sBAAAC,IAAA;QACA;QACA;QACA;QACAF,QAAA,CAAAG,OAAA,WAAAC,OAAA;UACA,IAAAzB,GAAA,GAAA0B,QAAA,CAAAD,OAAA,CAAAE,SAAA;UACA;UACA,SAAA3C,WAAA,kBAAAC,YAAA,UAAAe,GAAA,UAAAA,GAAA;YACAmB,GAAA,CAAAM,OAAA;cAAAG,KAAA;cAAApB,OAAA;YAAA;UACA;UACA,SAAAxB,WAAA,kBAAAC,YAAA,UAAAe,GAAA;YACAmB,GAAA,CAAAM,OAAA;cAAAG,KAAA;cAAApB,OAAA;YAAA;UACA;QACA,EAAAqB,IAAA;QACAT,IAAA,CAAA/B,UAAA,GAAAyC,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAE,SAAA,CAAAb,GAAA;MACA,EAAAU,IAAA;IACA;IACAI,UAAAjC,GAAA;MACA,IAAAyB,OAAA,QAAAzC,WAAA,SAAAqB,MAAA,MAAApB,YAAA,EAAAqB,QAAA,iBAAAD,MAAA,CAAAL,GAAA,EAAAM,QAAA;MACA4B,cAAA,CAAAC,OAAA,CAAAtD,WAAA,EAAA4C,OAAA;MACA,KAAAW,OAAA,CAAApB,IAAA,kBAAAqB,KAAA;IACA;IACAC,eAAA;MACA,KAAAF,OAAA,CAAApB,IAAA;IACA;EACA;EACAuB,QAAA;IAAA,IAAA5C,CAAA,OAAAC,IAAA;IAAA,KAAAZ,WAAA,GAAAW,CAAA,CAAAE,WAAA;IAAA,KAAAZ,YAAA,GAAAU,CAAA,CAAAG,QAAA;IAAA,KAAAN,cAAA;EAAA;AACA"}]}