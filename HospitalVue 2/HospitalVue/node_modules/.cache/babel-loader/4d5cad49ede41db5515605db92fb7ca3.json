lumn prop=\"deNumber\" label=\"医生人数\" width=\"100\"></el-table-column>\n    </el-table>\n  </el-card>\n</template>\n<script>\nimport request from \"@/utils/request.js\";\nexport default {\n  name: \"SectionList\",\n  data() { return { deptList: [] }; },\n  created() {\n    request.get(\"admin/findAllDoctors\", { params: { pageNumber: 1, size: 200, query: \"\" } }).then(res => {\n      if (res.data.status === 200) {\n        const doctors = res.data.data.doctors || [];\n        const deptMap = {};\n        doctors.forEach(d => {\n          if (d.dSection) {\n            if (!deptMap[d.dSection]) deptMap[d.dSection] = { deName: d.dSection, count: 0 };\n            deptMap[d.dSection].count++;\n          }\n        });\n        this.deptList = Object.values(deptMap).map((v, i) => ({ deId: 'DE' + String(i + 1).padStart(4, '0'), deName: v.deName, deNumber: v.count }));\n      }\n    });\n  }\n};\n</script>"],"mappings":"AAWA,OAAAA,OAAA;AACA;EACAC,IAAA;EACAC,KAAA;IAAA;MAAAC,QAAA;IAAA;EAAA;EACAC,QAAA;IACAJ,OAAA,CAAAK,GAAA;MAAAC,MAAA;QAAAC,UAAA;QAAAC,IAAA;QAAAC,KAAA;MAAA;IAAA,GAAAC,IAAA,CAAAC,GAAA;MACA,IAAAA,GAAA,CAAAT,IAAA,CAAAU,MAAA;QACA,MAAAC,OAAA,GAAAF,GAAA,CAAAT,IAAA,CAAAA,IAAA,CAAAW,OAAA;QACA,MAAAC,OAAA;QACAD,OAAA,CAAAE,OAAA,CAAAC,CAAA;UACA,IAAAA,CAAA,CAAAC,QAAA;YACA,KAAAH,OAAA,CAAAE,CAAA,CAAAC,QAAA,GAAAH,OAAA,CAAAE,CAAA,CAAAC,QAAA;cAAAC,MAAA,EAAAF,CAAA,CAAAC,QAAA;cAAAE,KAAA;YAAA;YACAL,OAAA,CAAAE,CAAA,CAAAC,QAAA,EAAAE,KAAA;UACA;QACA;QACA,KAAAhB,QAAA,GAAAiB,MAAA,CAAAC,MAAA,CAAAP,OAAA,EAAAQ,GAAA,EAAAC,CAAA,EAAAC,CAAA;UAAAC,IAAA,SAAAC,MAAA,CAAAF,CAAA,MAAAG,QAAA;UAAAT,MAAA,EAAAK,CAAA,CAAAL,MAAA;UAAAU,QAAA,EAAAL,CAAA,CAAAJ;QAAA;MACA;IACA;EACA;AACA"}]}