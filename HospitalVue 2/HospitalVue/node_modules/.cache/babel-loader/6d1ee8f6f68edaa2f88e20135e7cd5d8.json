lder=\"请输入患者id查询\">\r\n                        <el-button\r\n                            slot=\"append\"\r\n                            icon=\"el-icon-search\"\r\n                            @click=\"requestOrders\"\r\n                        ></el-button>\r\n                    </el-input>\r\n                </el-col>\r\n            </el-row>\r\n            <el-table :data=\"orderData\" stripe border style=\"width:100%\">\r\n                <el-table-column label=\"挂号单号\" prop=\"oId\"></el-table-column>\r\n                <el-table-column label=\"患者id\" prop=\"pId\"></el-table-column>\r\n                <el-table-column label=\"医生id\" prop=\"dId\"></el-table-column>\r\n                <!-- <el-table-column label=\"医生姓名\" prop=\"dName\"></el-table-column> -->\r\n                <el-table-column\r\n                    label=\"挂号时间\"\r\n                    prop=\"oStart\"\r\n                ></el-table-column>\r\n                <el-table-column label=\"结束时间\" prop=\"oEnd\"></el-table-column>\r\n                <el-table-column label=\"挂号状态\" prop=\"oState\">\r\n                    <template slot-scope=\"scope\">\r\n                        <el-tag v-if=\"scope.row.oState === 1\" type=\"success\"\r\n                            >已完成</el-tag\r\n                        >\r\n                        <el-tag v-if=\"scope.row.oState === 0\" type=\"danger\"\r\n                            >未完成</el-tag\r\n                        >\r\n                    </template>\r\n                </el-table-column>\r\n                <el-table-column label=\"操作\" width=\"200\" fixed=\"right\">\r\n                    <template slot-scope=\"scope\">\r\n                        <el-button\r\n                            type=\"warning\"\r\n                            icon=\"iconfont icon-r-home\"\r\n                            style=\"font-size: 14px\"\r\n                            @click=\"BedDiag(scope.row.pId, scope.row.dId)\"\r\n                        >\r\n                            申请留观/输液</el-button\r\n                        >\r\n                    </template>\r\n                </el-table-column>\r\n            </el-table>\r\n            <!-- 分页 -->\r\n            <el-pagination\r\n                @size-change=\"handleSizeChange\"\r\n                @current-change=\"handleCurrentChange\"\r\n                background\r\n                layout=\"total, sizes, prev, pager, next, jumper\"\r\n                :current-page=\"pageNumber\"\r\n                :page-size=\"size\"\r\n                :page-sizes=\"[1, 2, 4, 8, 16]\"\r\n                :total=\"total\"\r\n            >\r\n            </el-pagination>\r\n        </el-card>\r\n        <!-- 留观/输液对话框 -->\r\n        <el-dialog title=\"申请留观/输液\" :visible.sync=\"BedFormVisible\">\r\n            <el-form class=\"findPassword\" :model=\"bedForm\">\r\n                <el-form-item label=\"患者账号\" label-width=\"100px\" prop=\"pId\">\r\n                    <el-input v-model=\"bedForm.pId\" disabled></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"医生账号\" label-width=\"100px\">\r\n                    <el-input v-model=\"bedForm.dId\" disabled></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"申请理由\" label-width=\"100px\">\r\n                    <el-input\r\n                        v-model=\"bedForm.bReason\"\r\n                        type=\"textarea\"\r\n                        :rows=\"4\"\r\n                    ></el-input>\r\n                </el-form-item>\r\n                <el-form-item label=\"类型\" label-width=\"100px\" prop=\"bType\">\r\n                    <el-select v-model=\"bedForm.bType\" placeholder=\"请选择类型\">\r\n                        <el-option :value=\"0\" label=\"观察床\"></el-option>\r\n                        <el-option :value=\"1\" label=\"输液椅\"></el-option>\r\n                    </el-select>\r\n                </el-form-item>\r\n                <el-form-item label=\"选择编号\" label-width=\"100px\" prop=\"bId\">\r\n                    <el-select v-model=\"bedForm.bId\">\r\n                        <el-option\r\n                            v-for=\"item in nullBed\"\r\n                            :key=\"item.bId\"\r\n                            :label=\"item.bId\"\r\n                            :value=\"item.bId\"\r\n                        >\r\n                        </el-option>\r\n                    </el-select>\r\n                </el-form-item>\r\n            </el-form>\r\n            <div slot=\"footer\" class=\"dialog-footer\">\r\n                <el-button @click=\"BedFormVisible = false\" style=\"font-size: 18px;\"><i class=\"el-icon-close\" style=\"font-size: 20px;\"></i> 取 消</el-button>\r\n                <el-button type=\"primary\" @click=\"bedClick\"style=\"font-size: 18px;\"><i class=\"el-icon-check\" style=\"font-size: 20px;\"></i> 确 定</el-button>\r\n            </div>\r\n        </el-dialog>\r\n    </div>\r\n</template>\r\n<script>\r\nimport jwtDecode from \"jwt-decode\";\r\nimport { getToken } from \"@/utils/storage.js\";\r\nimport request from \"@/utils/request.js\";\r\nexport default {\r\n    name: \"InBed\",\r\n    data() {\r\n        return {\r\n            userId: 1,\r\n            userName: \"\",\r\n            pageNumber: 1,\r\n            size: 4,\r\n            query: \"\",\r\n            total: 3,\r\n            orderData: [],\r\n            //申请留观/输液对话框\r\n            BedFormVisible: false,\r\n            bedForm: {},\r\n            nullBed: [],\r\n        };\r\n    },\r\n    methods: {\r\n        //点击申请留观/输液确认按钮\r\n        bedClick() {\r\n            request\r\n                .get(\"bed/updateBed\", {\r\n                    params: {\r\n                        bId: this.bedForm.bId,\r\n                        dId: this.bedForm.dId,\r\n                        pId: this.bedForm.pId,\r\n                        bReason: this.bedForm.bReason,\r\n                        bType: this.bedForm.bType,\r\n                    },\r\n                })\r\n                .then((res) => {\r\n                    if (res.data.status !== 200)\r\n                        return this.$message.error(\"来晚了...该位置已被占用\");\r\n                    this.BedFormVisible = false;\r\n                    this.$message.success(\"申请留观/输液成功！\");\r\n                    this.requestOrders();\r\n                    \r\n                });\r\n        },\r\n\r\n        //请求所有空床位\r\n        requestBeds() {\r\n            request\r\n                .get(\"bed/findNullBed\")\r\n                .then((res) => {\r\n                    if (res.data.status !== 200)\r\n                        return this.$message.error(\"数据请求失败\");\r\n                    this.nullBed = res.data.data;\r\n                    \r\n                })\r\n                .catch((err) => {\r\n                    \r\n                });\r\n        },\r\n        //打开申请留观/输液对话框\r\n        BedDiag(pId, dId) {\r\n            this.bedForm.pId = pId;\r\n            this.bedForm.dId = dId;\r\n            this.BedFormVisible = true;\r\n            this.requestBeds();\r\n        },\r\n        //页面大小改变时触发\r\n        handleSizeChange(size) {\r\n            \r\n            this.size = size;\r\n            this.requestOrders();\r\n        },\r\n        //   页码改变时触发\r\n        handleCurrentChange(num) {\r\n            \r\n            this.pageNumber = num;\r\n            this.requestOrders();\r\n        },\r\n        //获取已完成的订单信息\r\n        requestOrders() {\r\n            request\r\n                .get(\"order/findOrderFinish\", {\r\n                    params: {\r\n                        dId: this.userId,\r\n                        pageNumber: this.pageNumber,\r\n                        size: this.size,\r\n                        query: this.query,\r\n                    },\r\n                })\r\n                .then((res) => {\r\n                    if (res.data.status !== 200)\r\n                        return this.$message.error(\"数据请求失败\");\r\n                    this.orderData = res.data.data.records;\r\n                    this.total = res.data.data.total;\r\n                });\r\n        },\r\n        //token解码\r\n        tokenDecode(token) {\r\n            if (token !== null) return jwtDecode(token);\r\n        },\r\n    },\r\n    created() {\r\n        //解码token信息\r\n        this.userId = this.tokenDecode(getToken()).dId;\r\n        this.userName = this.tokenDecode(getToken()).dName;\r\n        \r\n        \r\n        //获取订单信息\r\n        this.requestOrders();\r\n    },\r\n};\r\n</script>\r\n<style lang=\"scss\" scoped>\r\n.el-table {\r\n    margin-top: 20px;\r\n    margin-bottom: 20px;\r\n}\r\n</style>\r\n"],"mappings":"AAuGA,OAAAA,SAAA;AACA,SAAAC,QAAA;AACA,OAAAC,OAAA;AACA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,MAAA;MACAC,QAAA;MACAC,UAAA;MACAC,IAAA;MACAC,KAAA;MACAC,KAAA;MACAC,SAAA;MACA;MACAC,cAAA;MACAC,OAAA;MACAC,OAAA;IACA;EACA;EACAC,OAAA;IACA;IACAC,SAAA;MACAd,OAAA,CACAe,GAAA;QACAC,MAAA;UACAC,GAAA,OAAAN,OAAA,CAAAM,GAAA;UACAC,GAAA,OAAAP,OAAA,CAAAO,GAAA;UACAC,GAAA,OAAAR,OAAA,CAAAQ,GAAA;UACAC,OAAA,OAAAT,OAAA,CAAAS,OAAA;UACAC,KAAA,OAAAV,OAAA,CAAAU;QACA;MACA,GACAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAArB,IAAA,CAAAsB,MAAA,UACA,YAAAC,QAAA,CAAAC,KAAA;QACA,KAAAhB,cAAA;QACA,KAAAe,QAAA,CAAAE,OAAA;QACA,KAAAC,aAAA;MAEA;IACA;IAEA;IACAC,YAAA;MACA7B,OAAA,CACAe,GAAA,oBACAO,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAArB,IAAA,CAAAsB,MAAA,UACA,YAAAC,QAAA,CAAAC,KAAA;QACA,KAAAd,OAAA,GAAAW,GAAA,CAAArB,IAAA,CAAAA,IAAA;MAEA,GACA4B,KAAA,CAAAC,GAAA,KAEA;IACA;IACA;IACAC,QAAAb,GAAA,EAAAD,GAAA;MACA,KAAAP,OAAA,CAAAQ,GAAA,GAAAA,GAAA;MACA,KAAAR,OAAA,CAAAO,GAAA,GAAAA,GAAA;MACA,KAAAR,cAAA;MACA,KAAAmB,WAAA;IACA;IACA;IACAI,iBAAA3B,IAAA;MAEA,KAAAA,IAAA,GAAAA,IAAA;MACA,KAAAsB,aAAA;IACA;IACA;IACAM,oBAAAC,GAAA;MAEA,KAAA9B,UAAA,GAAA8B,GAAA;MACA,KAAAP,aAAA;IACA;IACA;IACAA,cAAA;MACA5B,OAAA,CACAe,GAAA;QACAC,MAAA;UACAE,GAAA,OAAAf,MAAA;UACAE,UAAA,OAAAA,UAAA;UACAC,IAAA,OAAAA,IAAA;UACAC,KAAA,OAAAA;QACA;MACA,GACAe,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAArB,IAAA,CAAAsB,MAAA,UACA,YAAAC,QAAA,CAAAC,KAAA;QACA,KAA