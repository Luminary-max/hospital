{"remainingRequest":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\babel-loader\\lib\\index.js!F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\cache-loader\\dist\\cjs.js??ref--1-0!F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\src\\views\\PharmacyDispensingList.vue?vue&type=script&lang=js&","dependencies":[{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\src\\views\\PharmacyDispensingList.vue","mtime":1782152022107},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\babel.config.js","mtime":1781696514000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781696522000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\babel-loader\\lib\\index.js","mtime":1781696520000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781696522000},{"path":"F:\\学习通作业\\软件工程实践2\\医院门诊管理系统\\HospitalVue 2\\HospitalVue\\node_modules\\vue-loader\\lib\\index.js","mtime":1781696552000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["request","name","data","pageNumber","size","statusFilter","query","dispensingData","total","guideVisible","guideLoading","guideData","methods","loadData","params","status","get","then","res","d","records","dispenseDrug","row","$prompt","inputPlaceholder","value","$message","warning","pdId","dispenseBy","success","error","msg","catch","reviewDrug","reviewBy","returnDrug","inputValidator","v","$confirm","type","returnBy","showDrugGuide","finally","printGuide","$nextTick","el","document","getElementById","safeEl","cloneNode","querySelectorAll","forEach","s","remove","printContents","innerHTML","win","window","open","write","close","setTimeout","print","created"],"sources":["src/views/PharmacyDispensingList.vue"],"sourcesContent":["<template>\n  <el-card>\n    <div slot=\"header\"><span><i class=\"el-icon-medicine\"></i> 药房发药管理</span></div>\n\n    <!-- 状态筛选 -->\n    <div class=\"toolbar\">\n      <div class=\"toolbar-left\">\n        <el-radio-group v-model=\"statusFilter\" @change=\"loadData\" size=\"small\">\n          <el-radio-button label=\"\">全部</el-radio-button>\n          <el-radio-button :label=\"0\">待发药</el-radio-button>\n          <el-radio-button :label=\"1\">待复核</el-radio-button>\n          <el-radio-button :label=\"2\">已发药</el-radio-button>\n          <el-radio-button :label=\"3\">已退药</el-radio-button>\n        </el-radio-group>\n        <el-input v-model=\"query\" placeholder=\"搜索订单ID/药品ID\" size=\"small\" class=\"search-input\" clearable @keyup.enter.native=\"loadData\">\n          <el-button slot=\"append\" icon=\"el-icon-search\" @click=\"loadData\"></el-button>\n        </el-input>\n      </div>\n      <div class=\"toolbar-right\">\n        <el-tag class=\"total-tag\">共 {{ total }} 条</el-tag>\n      </div>\n    </div>\n\n    <el-table :data=\"dispensingData\" border stripe style=\"width:100%\">\n      <el-table-column prop=\"pdId\" label=\"编号\" width=\"65\" align=\"center\"></el-table-column>\n      <el-table-column prop=\"oId\" label=\"订单ID\" width=\"75\" align=\"center\"></el-table-column>\n      <el-table-column prop=\"drId\" label=\"药品ID\" width=\"70\" align=\"center\"></el-table-column>\n      <el-table-column label=\"药品名称\" min-width=\"120\">\n        <template slot-scope=\"s\">{{ s.row.drName || '--' }}</template>\n      </el-table-column>\n      <el-table-column prop=\"dbId\" label=\"批次ID\" width=\"65\" align=\"center\"></el-table-column>\n      <el-table-column prop=\"pdQuantity\" label=\"数量\" width=\"60\" align=\"center\"></el-table-column>\n      <el-table-column label=\"状态\" width=\"80\" align=\"center\">\n        <template slot-scope=\"s\">\n          <el-tag v-if=\"s.row.pdStatus===0\" type=\"danger\" size=\"mini\">待发药</el-tag>\n          <el-tag v-else-if=\"s.row.pdStatus===1\" type=\"warning\" size=\"mini\">待复核</el-tag>\n          <el-tag v-else-if=\"s.row.pdStatus===2\" type=\"success\" size=\"mini\">已发药</el-tag>\n          <el-tag v-else type=\"info\" size=\"mini\">已退药</el-tag>\n        </template>\n      </el-table-column>\n      <el-table-column prop=\"pdCreateTime\" label=\"创建时间\" width=\"155\"></el-table-column>\n      <el-table-column prop=\"pdDispenseTime\" label=\"发药时间\" width=\"155\"></el-table-column>\n      <el-table-column prop=\"pdDispenseBy\" label=\"发药人\" width=\"80\" align=\"center\"></el-table-column>\n      <el-table-column prop=\"pdReviewBy\" label=\"复核药师\" width=\"85\" align=\"center\"></el-table-column>\n      <el-table-column prop=\"pdNote\" label=\"备注\" min-width=\"120\" show-overflow-tooltip></el-table-column>\n      <el-table-column label=\"操作\" width=\"200\" fixed=\"right\" align=\"center\">\n        <template slot-scope=\"s\">\n          <el-button type=\"success\" size=\"mini\" v-if=\"s.row.pdStatus===0\" @click=\"dispenseDrug(s.row)\">\n            确认发药\n          </el-button>\n          <el-button type=\"primary\" size=\"mini\" v-else-if=\"s.row.pdStatus===1\" @click=\"reviewDrug(s.row)\">\n            复核通过\n          </el-button>\n          <el-button type=\"warning\" size=\"mini\" v-else-if=\"s.row.pdStatus===2\" @click=\"returnDrug(s.row)\">\n            办理退药\n          </el-button>\n          <el-tag type=\"info\" v-else size=\"mini\">已退回</el-tag>\n          <el-button v-if=\"s.row.pdStatus===2\" type=\"info\" size=\"mini\" plain @click=\"showDrugGuide(s.row)\">\n            用药指导\n          </el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n\n    <el-pagination @size-change=\"s=>{size=s;loadData()}\" @current-change=\"p=>{pageNumber=p;loadData()}\"\n      :current-page=\"pageNumber\" :page-sizes=\"[10,20,30]\" :page-size=\"size\"\n      layout=\"total,sizes,prev,pager,next,jumper\" :total=\"total\" style=\"margin-top:15px;\">\n    </el-pagination>\n\n    <!-- 用药指导对话框 -->\n    <el-dialog title=\"用药指导单\" :visible.sync=\"guideVisible\" width=\"680px\" top=\"5vh\">\n      <div v-if=\"guideLoading\" style=\"text-align:center;padding:40px;\">\n        <i class=\"el-icon-loading\" style=\"font-size:28px;color:#409EFF;\"></i>\n        <p style=\"color:#999;margin-top:10px;\">加载用药指导信息...</p>\n      </div>\n      <div v-else id=\"guidePrintArea\" class=\"guide-print\">\n        <div class=\"guide-header\">\n          <h2 style=\"text-align:center;margin:0 0 8px 0;\">用药指导单</h2>\n          <p style=\"text-align:center;color:#909399;font-size:13px;margin:0 0 16px 0;\">\n            请仔细阅读以下用药说明，如有疑问请咨询医生或药师\n          </p>\n        </div>\n        <el-divider></el-divider>\n        <div class=\"guide-section\" v-if=\"guideData.drName\">\n          <h4>药品信息</h4>\n          <el-descriptions :column=\"2\" border size=\"small\">\n            <el-descriptions-item label=\"药品名称\" :span=\"2\">{{ guideData.drName }}</el-descriptions-item>\n            <el-descriptions-item label=\"用法\">{{ guideData.pdUsage || '--' }}</el-descriptions-item>\n            <el-descriptions-item label=\"用量\">{{ guideData.pdDosage || '--' }}</el-descriptions-item>\n            <el-descriptions-item label=\"频次\">{{ guideData.pdFrequency || '--' }}</el-descriptions-item>\n            <el-descriptions-item label=\"给药途径\">{{ guideData.pdRoute || '--' }}</el-descriptions-item>\n          </el-descriptions>\n        </div>\n        <div class=\"guide-section\">\n          <h4>注意事项</h4>\n          <el-descriptions :column=\"1\" border size=\"small\">\n            <el-descriptions-item label=\"禁忌症\">{{ guideData.drContraindication || '无特殊禁忌' }}</el-descriptions-item>\n            <el-descriptions-item label=\"不良反应\">{{ guideData.drAdverseReactions || '--' }}</el-descriptions-item>\n            <el-descriptions-item label=\"储存条件\">{{ guideData.drStorage || '--' }}</el-descriptions-item>\n            <el-descriptions-item label=\"使用提示\">{{ guideData.drUsageTips || '--' }}</el-descriptions-item>\n          </el-descriptions>\n        </div>\n        <div style=\"text-align:center;color:#c0c4cc;font-size:11px;margin-top:20px;border-top:1px dashed #eee;padding-top:12px;\">\n          本指导单由医院门诊管理系统自动生成，仅供用药参考\n        </div>\n      </div>\n      <div slot=\"footer\">\n        <el-button @click=\"guideVisible=false\">关闭</el-button>\n        <el-button type=\"primary\" icon=\"el-icon-printer\" @click=\"printGuide\">打印</el-button>\n      </div>\n    </el-dialog>\n  </el-card>\n</template>\n<script>\nimport request from \"@/utils/request.js\";\nexport default {\n  name: \"PharmacyDispensingList\",\n  data() {\n    return {\n      pageNumber:1, size:10, statusFilter:'', query:'', dispensingData:[], total:0,\n      guideVisible: false, guideLoading: false, guideData: {}\n    };\n  },\n  methods: {\n    loadData() {\n      const params = {\n        pageNumber:this.pageNumber, size:this.size,\n        status:this.statusFilter===''?null:this.statusFilter,\n        query:this.query||null\n      };\n      request.get(\"pharmacy/findAll\", { params })\n        .then(res => {\n          const d=res.data.data;\n          this.dispensingData=d.records||[];\n          this.total=d.total||0;\n        });\n    },\n    // 待发药 → 待复核（确认发药）\n    dispenseDrug(row) {\n      this.$prompt(\"请输入发药人姓名\", \"确认发药\", { inputPlaceholder:\"药剂师姓名\" }).then(({ value })=> {\n        if (!value) return this.$message.warning(\"请输入发药人\");\n        // API: GET pharmacy/dispense — 设置pdStatus=1(待复核)\n        request.get(\"pharmacy/dispense\", { params: { pdId:row.pdId, dispenseBy:value } }).then(res => {\n          if (res.data.status===200) {\n            this.$message.success(\"发药成功，等待复核！\");\n            this.loadData();\n          } else this.$message.error(res.data.msg||\"发药失败\");\n        }).catch(()=>this.$message.error(\"请求失败\"));\n      }).catch(()=>{});\n    },\n    // 待复核 → 已发药（复核通过）\n    reviewDrug(row) {\n      this.$prompt(\"请输入复核药师姓名\", \"复核确认\", { inputPlaceholder:\"复核药师\" }).then(({ value })=> {\n        if (!value) return this.$message.warning(\"请输入复核药师\");\n        // API: GET pharmacy/review — 需要后端实现\n        request.get(\"pharmacy/review\", { params: { pdId:row.pdId, reviewBy:value } }).then(res => {\n          if (res.data.status===200) {\n            this.$message.success(\"复核通过，发药完成！\");\n            this.loadData();\n          } else this.$message.error(res.data.msg||\"复核失败\");\n        }).catch(()=>this.$message.error(\"请求失败\"));\n      }).catch(()=>{});\n    },\n    // 已发药 → 已退药（办理退药）\n    returnDrug(row) {\n      this.$prompt(\"请输入退药操作人\", \"办理退药\", { inputPlaceholder:\"药剂师姓名\", inputValidator:v=>!!v||\"请输入操作人\" }).then(({value})=>{\n        return this.$confirm(\"退药后库存将回补到原发药批次，确认继续？\",\"退药确认\",{type:\"warning\"}).then(()=>{\n          // API: GET pharmacy/returnDrug\n          request.get(\"pharmacy/returnDrug\",{params:{pdId:row.pdId,returnBy:value}}).then(res=>{\n            if(res.data.status===200){\n              this.$message.success(\"退药成功，库存已回补\");\n              this.loadData();\n            } else this.$message.error(res.data.msg||\"退药失败\");\n          }).catch(()=>this.$message.error(\"请求失败\"));\n        });\n      }).catch(()=>{});\n    },\n    // 用药指导\n    showDrugGuide(row) {\n      this.guideVisible = true;\n      this.guideLoading = true;\n      this.guideData = {};\n      request.get(\"pharmacy/printGuide\", { params: { pdId: row.pdId } }).then(res => {\n        if (res.data.status === 200) {\n          this.guideData = res.data.data || {};\n        } else {\n          this.$message.error(res.data.msg || \"获取用药指导失败\");\n        }\n      }).catch(() => {\n        this.$message.error(\"请求失败\");\n      }).finally(() => {\n        this.guideLoading = false;\n      });\n    },\n    printGuide() {\n      this.$nextTick(() => {\n        const el = document.getElementById(\"guidePrintArea\");\n        if (!el) return;\n        // Strip potential script elements before printing (XSS defense-in-depth)\n        const safeEl = el.cloneNode(true);\n        safeEl.querySelectorAll(\"script\").forEach(s => s.remove());\n        const printContents = safeEl.innerHTML;\n        const win = window.open(\"\", \"_blank\", \"width=780,height=900\");\n        win.document.write(`\n          <html>\n          <head>\n            <title>用药指导单</title>\n            <style>\n              body { font-family: \"Microsoft YaHei\", sans-serif; padding: 40px; color: #333; }\n              .guide-header { text-align: center; margin-bottom: 20px; }\n              .guide-header h2 { margin: 0 0 8px 0; }\n              .guide-header p { color: #909399; font-size: 13px; margin: 0 0 16px 0; }\n              .guide-section { margin-bottom: 20px; }\n              .guide-section h4 { color: #409EFF; border-left: 3px solid #409EFF; padding-left: 10px; margin: 16px 0 10px 0; }\n              table { width: 100%; border-collapse: collapse; font-size: 13px; }\n              table td, table th { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }\n              table th { background: #f5f7fa; font-weight: 600; width: 100px; }\n              .footer { text-align: center; color: #c0c4cc; font-size: 11px; margin-top: 30px; border-top: 1px dashed #eee; padding-top: 12px; }\n            </style>\n          </head>\n          <body>${printContents}</body>\n          </html>\n        `);\n        win.document.close();\n        setTimeout(() => { win.print(); }, 300);\n      });\n    }\n  },\n  created() { this.loadData(); }\n};\n</script>\n<style scoped>\n.toolbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }\n.toolbar-left { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }\n.toolbar-right { display:flex; align-items:center; gap:8px; }\n.search-input { width:220px; }\n.total-tag { margin-left:8px; }\n.guide-section { margin-bottom:16px; }\n.guide-section h4 { color:#409EFF; border-left:3px solid #409EFF; padding-left:10px; margin:12px 0 10px 0; }\n@media print { .guide-print { padding: 20px; } }\n</style>\n\n\n"],"mappings":"AAkHA,OAAAA,OAAA;AACA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;MAAAC,IAAA;MAAAC,YAAA;MAAAC,KAAA;MAAAC,cAAA;MAAAC,KAAA;MACAC,YAAA;MAAAC,YAAA;MAAAC,SAAA;IACA;EACA;EACAC,OAAA;IACAC,SAAA;MACA,MAAAC,MAAA;QACAX,UAAA,OAAAA,UAAA;QAAAC,IAAA,OAAAA,IAAA;QACAW,MAAA,OAAAV,YAAA,sBAAAA,YAAA;QACAC,KAAA,OAAAA,KAAA;MACA;MACAN,OAAA,CAAAgB,GAAA;QAAAF;MAAA,GACAG,IAAA,CAAAC,GAAA;QACA,MAAAC,CAAA,GAAAD,GAAA,CAAAhB,IAAA,CAAAA,IAAA;QACA,KAAAK,cAAA,GAAAY,CAAA,CAAAC,OAAA;QACA,KAAAZ,KAAA,GAAAW,CAAA,CAAAX,KAAA;MACA;IACA;IACA;IACAa,aAAAC,GAAA;MACA,KAAAC,OAAA;QAAAC,gBAAA;MAAA,GAAAP,IAAA;QAAAQ;MAAA;QACA,KAAAA,KAAA,cAAAC,QAAA,CAAAC,OAAA;QACA;QACA3B,OAAA,CAAAgB,GAAA;UAAAF,MAAA;YAAAc,IAAA,EAAAN,GAAA,CAAAM,IAAA;YAAAC,UAAA,EAAAJ;UAAA;QAAA,GAAAR,IAAA,CAAAC,GAAA;UACA,IAAAA,GAAA,CAAAhB,IAAA,CAAAa,MAAA;YACA,KAAAW,QAAA,CAAAI,OAAA;YACA,KAAAjB,QAAA;UACA,YAAAa,QAAA,CAAAK,KAAA,CAAAb,GAAA,CAAAhB,IAAA,CAAA8B,GAAA;QACA,GAAAC,KAAA,YAAAP,QAAA,CAAAK,KAAA;MACA,GAAAE,KAAA;IACA;IACA;IACAC,WAAAZ,GAAA;MACA,KAAAC,OAAA;QAAAC,gBAAA;MAAA,GAAAP,IAAA;QAAAQ;MAAA;QACA,KAAAA,KAAA,cAAAC,QAAA,CAAAC,OAAA;QACA;QACA3B,OAAA,CAAAgB,GAAA;UAAAF,MAAA;YAAAc,IAAA,EAAAN,GAAA,CAAAM,IAAA;YAAAO,QAAA,EAAAV;UAAA;QAAA,GAAAR,IAAA,CAAAC,GAAA;UACA,IAAAA,GAAA,CAAAhB,IAAA,CAAAa,MAAA;YACA,KAAAW,QAAA,CAAAI,OAAA;YACA,KAAAjB,QAAA;UACA,YAAAa,QAAA,CAAAK,KAAA,CAAAb,GAAA,CAAAhB,IAAA,CAAA8B,GAAA;QACA,GAAAC,KAAA,YAAAP,QAAA,CAAAK,KAAA;MACA,GAAAE,KAAA;IACA;IACA;IACAG,WAAAd,GAAA;MACA,KAAAC,OAAA;QAAAC,gBAAA;QAAAa,cAAA,EAAAC,CAAA,MAAAA,CAAA;MAAA,GAAArB,IAAA;QAAAQ;MAAA;QACA,YAAAc,QAAA;UAAAC,IAAA;QAAA,GAAAvB,IAAA;UACA;UACAjB,OAAA,CAAAgB,GAAA;YAAAF,MAAA;cAAAc,IAAA,EAAAN,GAAA,CAAAM,IAAA;cAAAa,QAAA,EAAAhB;YAAA;UAAA,GAAAR,IAAA,CAAAC,GAAA;YACA,IAAAA,GAAA,CAAAhB,IAAA,CAAAa,MAAA;cACA,KAAAW,QAAA,CAAAI,OAAA;cACA,KAAAjB,QAAA;YACA,YAAAa,QAAA,CAAAK,KAAA,CAAAb,GAAA,CAAAhB,IAAA,CAAA8B,GAAA;UACA,GAAAC,KAAA,YAAAP,QAAA,CAAAK,KAAA;QACA;MACA,GAAAE,KAAA;IACA;IACA;IACAS,cAAApB,GAAA;MACA,KAAAb,YAAA;MACA,KAAAC,YAAA;MACA,KAAAC,SAAA;MACAX,OAAA,CAAAgB,GAAA;QAAAF,MAAA;UAAAc,IAAA,EAAAN,GAAA,CAAAM;QAAA;MAAA,GAAAX,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAhB,IAAA,CAAAa,MAAA;UACA,KAAAJ,SAAA,GAAAO,GAAA,CAAAhB,IAAA,CAAAA,IAAA;QACA;UACA,KAAAwB,QAAA,CAAAK,KAAA,CAAAb,GAAA,CAAAhB,IAAA,CAAA8B,GAAA;QACA;MACA,GAAAC,KAAA;QACA,KAAAP,QAAA,CAAAK,KAAA;MACA,GAAAY,OAAA;QACA,KAAAjC,YAAA;MACA;IACA;IACAkC,WAAA;MACA,KAAAC,SAAA;QACA,MAAAC,EAAA,GAAAC,QAAA,CAAAC,cAAA;QACA,KAAAF,EAAA;QACA;QACA,MAAAG,MAAA,GAAAH,EAAA,CAAAI,SAAA;QACAD,MAAA,CAAAE,gBAAA,WAAAC,OAAA,CAAAC,CAAA,IAAAA,CAAA,CAAAC,MAAA;QACA,MAAAC,aAAA,GAAAN,MAAA,CAAAO,SAAA;QACA,MAAAC,GAAA,GAAAC,MAAA,CAAAC,IAAA;QACAF,GAAA,CAAAV,QAAA,CAAAa,KAAA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,kBAAAL,aAAA;AACA;AACA;QACAE,GAAA,CAAAV,QAAA,CAAAc,KAAA;QACAC,UAAA;UAAAL,GAAA,CAAAM,KAAA;QAAA;MACA;IACA;EACA;EACAC,QAAA;IAAA,KAAAnD,QAAA;EAAA;AACA"}]}