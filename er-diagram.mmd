erDiagram
    %% ===== 基础数据 =====
    科室 {
        int de_id PK
        string de_name
        string de_introduce
    }
    医生 {
        string d_id PK
        string d_name
        string d_post
        string d_section FK
        string d_phone
        int d_max_daily
    }
    患者 {
        int p_id PK
        string p_name
        string p_gender
        string p_phone
        string p_card
        string p_insurance_id
        string p_insurance_type
        string p_blacklisted
    }
    药品 {
        string dr_id PK
        string dr_name
        double dr_price
        string dr_unit
        string dr_type
        int dr_number
    }
    药品分类 {
        int dc_id PK
        string dc_name
        int dc_parent_id FK
    }
