    发药记录 {
        int pds_id PK
        int presc_detail_id FK
        int db_id FK
        int pd_quantity
        int pd_status
        string pd_dispense_by
        string pd_review_by
        string pd_return_by
    }

    %% ===== 检查流程 =====
    检查开单 {
        int oc_id PK
        int o_id FK
        string ch_id FK
        double ch_price
        int oc_status
        string oc_result
        string oc_result_time
        string oc_operator
    }

