        string physical_exam
        string diagnosis
        string treatment_plan
        string allergy_history
        string medical_advice
        string follow_up_suggest
    }

    %% ===== 处方流程 =====
    处方主表 {
        int pm_id PK
        int o_id FK
        string d_id FK
        string pm_diagnosis
        string pm_type
        int pm_status
        string pm_create_time
    }
    处方明细 {
        int pd_id PK
