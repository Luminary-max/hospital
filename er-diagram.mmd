    }
    处方模板 {
        int pt_id PK
        string pt_name
        string d_id FK
        string pt_diagnosis
        string pt_dept
        string pt_content
    }
    病历模板 {
        int et_id PK
        string et_name
        string d_id FK
        string et_chief_complaint
        string et_diagnosis
    }
    诊断字典 {
        int dd_id PK
        string dd_code
        string dd_name
        string dd_dept
    }

